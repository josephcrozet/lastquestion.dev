{
  "name": "lastquestion-dev",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow bun",
    "postinstall": "simple-git-hooks",
    "dev": "astro dev",
    "build": "astro build",
    "build:ci": "bun run --parallel build",
    "preview": "astro preview --open",
    "start": "bun run build && bun run preview",
    "astro": "astro",
    "format": "biome check --linter-enabled=false . && prettier --check --log-level warn .",
    "format:fix": "biome format --write . && prettier --write --log-level warn .",
    "lint": "biome lint --error-on-warnings . && eslint --max-warnings 0 .",
    "lint:fix": "biome check --write --formatter-enabled=false . && eslint --fix .",
    "knip": "knip",
    "check": "astro check --silent",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:ci": "bun run --parallel test:unit test:e2e",
    "verify": "bun run --parallel format lint knip check",
    "fix": "bun run --sequential lint:fix format:fix",
    "ci": "bun run verify && bun run build:ci && bun run test:ci"
  },
  "simple-git-hooks": {
    "pre-push": "bun run ci"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "knip": "^6.35.1",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26.0.0"
  }
}
